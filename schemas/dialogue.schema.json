{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dialogue.schema.json",
  "title": "Dialogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "languageId", "level", "sourceRefs", "scenario", "turns"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "languageId": {"type": "string", "minLength": 1},
    "level": {"enum": ["Pre-A1", "A1", "A2", "B1", "B2", "C1", "C2"]},
    "sourceRefs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "scenario": {"type": "string", "minLength": 1},
    "characterRefs": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true,
      "description": "Actual participating characters. Speaker count is scene-driven and has no fixed target or preferred range."
    },
    "turns": {
      "type": "array",
      "description": "Fully dynamic-length conversation. No min/max/target/preferred turn count or learner-turn count is encoded. QA evaluates semantic completeness and meaningful participation.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "speakerCharacterId", "speakerIdentityOrigin", "textTarget", "translationFa", "learnerTurn", "sourceRefs"],
        "properties": {
          "id": {"type": "string"},
          "speakerCharacterId": {"type": "string"},
          "speakerIdentityOrigin": {"enum": ["source", "app_assigned"]},
          "speakerGenderEvidence": {"enum": ["female", "male", "unspecified", "not_applicable"]},
          "textTarget": {"type": "string", "minLength": 1},
          "translationFa": {"type": "string", "minLength": 1},
          "learnerTurn": {"type": "boolean"},
          "lexemeRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
          "sourceRefs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "audioRef": {"type": ["string", "null"], "default": null}
        }
      }
    },
    "sceneQualityRationale": {
      "type": ["string", "null"],
      "description": "Optional editorial explanation of why this scene is complete/appropriate. Numeric turn targets are not valid rationale."
    }
  }
}
