{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dialogue.schema.json",
  "title": "Dialogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "languageId", "level", "sourceRefs", "scenario", "openingInitiator", "turns"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "languageId": {"type": "string", "minLength": 1},
    "level": {"enum": ["Pre-A1", "A1", "A2", "B1", "B2", "C1", "C2"]},
    "sourceRefs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "scenario": {"type": "string", "minLength": 1},
    "openingInitiator": {"enum": ["app", "learner"], "description": "مشخص می‌کند اولین turn را اپلیکیشن/کاراکتر یا خود زبان‌آموز شروع می‌کند."},
    "characterRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "turns": {"type": "array", "minItems": 5, "maxItems": 12, "description": "مکالمهٔ آغازین باید بین ۵ تا ۱۲ turn باشد.", "items": {"type": "object", "additionalProperties": false, "required": ["id", "speakerCharacterId", "speakerIdentityOrigin", "textTarget", "translationFa", "learnerTurn", "sourceRefs"], "properties": {"id": {"type": "string"}, "speakerCharacterId": {"type": "string"}, "speakerIdentityOrigin": {"enum": ["source", "app_assigned"]}, "speakerGenderEvidence": {"enum": ["female", "male", "unspecified", "not_applicable"]}, "textTarget": {"type": "string", "minLength": 1}, "translationFa": {"type": "string", "minLength": 1}, "learnerTurn": {"type": "boolean"}, "lexemeRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []}, "lexemeOccurrences": {"type": "array", "default": [], "items": {"type": "object", "additionalProperties": false, "required": ["surface", "lexemeId", "lexemeFormId"], "properties": {"surface": {"type": "string", "minLength": 1}, "lexemeId": {"type": "string", "minLength": 1}, "lexemeFormId": {"type": ["string", "null"]}}}}, "sourceRefs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}, "audioRef": {"type": ["string", "null"], "default": null}}}},
    "sceneQualityRationale": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"openingInitiator": {"const": "learner"}}, "required": ["openingInitiator"]}, "then": {"properties": {"turns": {"prefixItems": [{"properties": {"learnerTurn": {"const": true}}, "required": ["learnerTurn"]}]}}}},
    {"if": {"properties": {"openingInitiator": {"const": "app"}}, "required": ["openingInitiator"]}, "then": {"properties": {"turns": {"prefixItems": [{"properties": {"learnerTurn": {"const": false}}, "required": ["learnerTurn"]}]}}}}
  ]
}
