{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "activity.schema.json",
  "title": "Lesson Activity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "sourceRefs",
    "learningTargets",
    "data",
    "audioStatus"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "conversation_speaking",
        "listen_choose",
        "multiple_choice",
        "choose_response",
        "word_order",
        "fill_blank",
        "matching",
        "listen_repeat",
        "pronunciation_read",
        "grammar_focus",
        "comprehension",
        "true_false",
        "review"
      ]
    },
    "instructionFa": {
      "type": "string"
    },
    "selectionReason": {
      "type": "string"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "learningTargets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "lexemeRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "dialogueRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "$ref": "#/$defs/imageFreeObject",
      "description": "Activity-specific payload. Target-language instructional text inside this object must remain source-backed. The current product baseline forbids instructional image fields at any nesting depth."
    },
    "transformations": {
      "type": "array",
      "items": {
        "enum": [
          "verbatim_dialogue",
          "persian_translation_added",
          "sentence_tokenized_for_word_order",
          "source_sentence_blank_created",
          "source_items_grouped_for_matching",
          "options_selected_from_source_material",
          "source_items_grouped_for_pronunciation",
          "character_metadata_added",
          "cefr_level_assigned_by_app",
          "other"
        ]
      },
      "uniqueItems": true,
      "default": []
    },
    "audioStatus": {
      "enum": [
        "not_required",
        "blocked_until_level_final",
        "pending",
        "ready",
        "stale",
        "failed"
      ]
    },
    "audioTextTarget": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "default": null,
      "description": "متن دقیق زبان هدف برای فایل صوتی مستقل این فعالیت. برای فعالیت‌هایی که صوت مستقل ندارند null است."
    }
  },
  "$defs": {
    "imageFreeObject": {
      "type": "object",
      "propertyNames": {
        "not": {
          "pattern": "^(image|imageUrl|imageURL|imageRef|image_url|image_ref|picture|photo|illustration|thumbnail|thumbnailUrl|thumbnailURL|thumbnailRef|thumbnail_url|thumbnail_ref)$"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/imageFreeValue"
      }
    },
    "imageFreeValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/imageFreeObject"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/imageFreeValue"
          }
        },
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "conversation_speaking"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "dialogueRef"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "matching"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "pairMode",
              "pairs"
            ],
            "properties": {
              "pairs": {
                "type": "array",
                "minItems": 4,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": [
                    "left",
                    "leftFa",
                    "right",
                    "rightFa"
                  ],
                  "properties": {
                    "left": {
                      "type": "string",
                      "minLength": 1
                    },
                    "right": {
                      "type": "string",
                      "minLength": 1
                    },
                    "leftFa": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "[\\u0600-\\u06FF]"
                    },
                    "rightFa": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "[\\u0600-\\u06FF]"
                    }
                  }
                }
              },
              "pairMode": {
                "enum": [
                  "target_to_persian",
                  "target_to_target"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
