{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson.schema.json",
  "title": "Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "languageId",
    "level",
    "titleFa",
    "learningTargets",
    "sourceRefs",
    "activities",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "languageId": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "Pre-A1",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "unitRef": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional while planning. Unit assignment is based on pedagogical grouping, never target unit capacity."
    },
    "titleFa": {
      "type": "string",
      "minLength": 1
    },
    "sourceTitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "learningTargets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "lexemeRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "grammarNoteRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "activityDesign": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activitySelectionRationale": {
          "type": "string",
          "description": "Why the selected activities are pedagogically needed. Numeric target counts are not valid rationale."
        },
        "sequenceRationale": {
          "type": "string"
        },
        "templateSignature": {
          "type": "string",
          "description": "Optional derived signature used by QA to detect repetitive neighboring lesson patterns."
        }
      }
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "description": "Dynamic-length sequence. Every finalized lesson opens with conversation_speaking and must satisfy the CEFR-level activity-count quality guardrail configured in config/activity-count-bounds.json. Drafts may temporarily be below the configured minimum; there is no preferred exact activity count inside the allowed range.",
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "activity.schema.json"
            },
            {
              "properties": {
                "type": {
                  "const": "conversation_speaking"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        }
      ],
      "items": {
        "$ref": "activity.schema.json"
      }
    },
    "status": {
      "enum": [
        "draft",
        "source_checked",
        "cefr_checked",
        "qa",
        "final"
      ]
    },
    "audioStatus": {
      "enum": [
        "not_required",
        "blocked_until_level_final",
        "pending",
        "ready",
        "stale",
        "failed"
      ],
      "default": "blocked_until_level_final"
    },
    "sourceTitleFa": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "[\\u0600-\\u06FF]",
      "description": "معادل یا برچسب فارسی برای sourceTitle."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sourceTitle": {
            "type": "string"
          }
        },
        "required": [
          "sourceTitle"
        ]
      },
      "then": {
        "required": [
          "sourceTitleFa"
        ]
      }
    }
  ]
}
