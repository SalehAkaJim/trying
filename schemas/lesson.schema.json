{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson.schema.json",
  "title": "Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "languageId",
    "level",
    "titleFa",
    "learningTargets",
    "sourceRefs",
    "activities",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "languageId": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "Pre-A1",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "unitRef": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional while planning. Unit assignment is based on pedagogical grouping, never target unit capacity."
    },
    "titleFa": {
      "type": "string",
      "minLength": 1
    },
    "sourceTitle": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Target-language lesson title/excerpt. Required for finalized lessons; must be source-backed."
    },
    "learningTargets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "lexemeRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "grammarNoteRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "activityDesign": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activitySelectionRationale": {
          "type": "string",
          "description": "دلیل آموزشی انتخاب فعالیت‌های پس از گفت‌وگوی آغازین و کافی‌بودن همین تعداد؛ گفت‌وگوی اول ثابت است اما از فعالیت دوم به بعد هیچ تعداد یا نوع ترجیحی وجود ندارد.",
          "minLength": 1
        },
        "sequenceRationale": {
          "type": "string",
          "minLength": 1,
          "description": "دلیل آموزشی ترتیب فعالیت‌های پس از گفت‌وگوی آغازین؛ ترتیب باید از نیاز همان درس بیاید و نه از الگوی مشترک درس‌های دیگر."
        },
        "templateSignature": {
          "type": "string",
          "description": "Optional derived signature used by QA to detect repetitive neighboring lesson patterns."
        }
      },
      "required": [
        "activitySelectionRationale",
        "sequenceRationale"
      ]
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "description": "Sequence with one fixed exception: activity 1 is always conversation_speaking backed by turns, and conversation_speaking may not appear again in the lesson. From activity 2 onward, type, order, and exact count are dynamic and selected by learning need. Finalized lessons must remain inside the CEFR-level total activity-count guardrail.",
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "activity.schema.json"
            },
            {
              "properties": {
                "type": {
                  "const": "conversation_speaking"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        }
      ],
      "items": {
        "$ref": "activity.schema.json"
      },
      "contains": {
        "properties": {
          "type": {
            "const": "conversation_speaking"
          }
        },
        "required": [
          "type"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "status": {
      "enum": [
        "draft",
        "source_checked",
        "cefr_checked",
        "qa",
        "final"
      ]
    },
    "audioStatus": {
      "enum": [
        "not_required",
        "blocked_until_level_final",
        "pending",
        "ready",
        "stale",
        "failed"
      ],
      "default": "blocked_until_level_final"
    },
    "sourceTitleFa": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "[\\u0600-\\u06FF]",
      "description": "معادل فارسی عنوان زبان هدفِ درس."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "final"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "sourceTitle",
          "sourceTitleFa",
          "activityDesign"
        ],
        "properties": {
          "sourceTitle": {
            "type": "string",
            "minLength": 1
          },
          "sourceTitleFa": {
            "type": "string",
            "minLength": 1,
            "pattern": "[\\u0600-\\u06FF]"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sourceTitle": {
            "type": "string"
          }
        },
        "required": [
          "sourceTitle"
        ]
      },
      "then": {
        "required": [
          "sourceTitleFa"
        ]
      }
    }
  ]
}
