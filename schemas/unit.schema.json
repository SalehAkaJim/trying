{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unit.schema.json",
  "title": "Curriculum Unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "languageId",
    "level",
    "titleFa",
    "learningTargets",
    "lessonRefs",
    "groupingRationale",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "languageId": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "Pre-A1",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "titleFa": {
      "type": "string",
      "minLength": 1
    },
    "learningTargets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lessonRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "طول این آرایه خروجی طراحی آموزشی است. برای Unit نهایی از A1 به بعد فقط guardrail پیکربندی‌شدهٔ ۳–۱۲ اعمال می‌شود؛ ابتدا learning needs، source inventory و progression تعیین می‌شوند و count در پایان از مرزهای واقعی Lesson استخراج می‌شود."
    },
    "groupingRationale": {
      "type": "string",
      "minLength": 1,
      "description": "دلیل آموزشی/ناوبریِ اینکه دقیقاً همین Lessonها در یک Unit هستند و چرا این مرز Unit در این نقطه قرار دارد. باید progression، پوشش و کافی‌بودن تعداد فعلی Lessonها را توضیح دهد؛ ارجاع به بازهٔ ۳–۱۲، minimum، هماهنگی با Unitهای دیگر یا زیبایی عددی rationale معتبر نیست."
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "final"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  }
}
