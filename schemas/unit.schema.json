{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unit.schema.json",
  "title": "Curriculum Unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "languageId",
    "level",
    "titleFa",
    "learningTargets",
    "lessonRefs",
    "groupingRationale",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "languageId": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "Pre-A1",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "titleFa": {
      "type": "string",
      "minLength": 1
    },
    "learningTargets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lessonRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Dynamic-length lesson grouping. For finalized units from A1 onward, project policy requires 3–12 lessons as configured in config/unit-lesson-count-bounds.json; the exact count inside that range is determined by pedagogical need rather than quota filling."
    },
    "groupingRationale": {
      "type": "string",
      "minLength": 1,
      "description": "Pedagogical/navigation reason these lessons belong together. The rationale must explain progression and coverage; merely citing the allowed 3–12 lesson range is not sufficient."
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "final"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  }
}
