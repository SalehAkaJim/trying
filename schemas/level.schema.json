{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "level.schema.json",
  "title": "CEFR Level Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "languageId",
    "level",
    "status",
    "coverage",
    "audioStatus"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "languageId": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "Pre-A1",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "status": {
      "enum": [
        "unassessed",
        "planning",
        "building",
        "review",
        "final"
      ]
    },
    "structureRationale": {
      "type": [
        "string",
        "null"
      ],
      "description": "Explains the current curriculum structure. It must be coverage/pedagogy based and must not use numeric unit/lesson quotas as justification."
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "communicativeTargets",
        "linguisticTargets",
        "situations",
        "gaps"
      ],
      "properties": {
        "communicativeTargets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "linguisticTargets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "situations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "completionAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewedAt",
        "cefrCoverageComplete",
        "progressionComplete",
        "practiceAndRetrievalComplete",
        "skillModeCoverageComplete",
        "requiredGaps",
        "qualityReview",
        "scopeExclusions"
      ],
      "properties": {
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "cefrCoverageComplete": {
          "type": "boolean"
        },
        "progressionComplete": {
          "type": "boolean"
        },
        "practiceAndRetrievalComplete": {
          "type": "boolean"
        },
        "skillModeCoverageComplete": {
          "type": "boolean"
        },
        "requiredGaps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "qualityReview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "overallScore",
            "dimensionScores",
            "rationale",
            "strengths",
            "remainingWeaknesses"
          ],
          "properties": {
            "overallScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "dimensionScores": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cefrCoverage",
                "pedagogicalProgression",
                "practiceAndRetrieval",
                "activityQualityAndVariety",
                "linguisticAccuracyAndNaturalness",
                "sourceQualityAndCurrency",
                "learnerSupportAndClarity",
                "qaIntegrity"
              ],
              "properties": {
                "cefrCoverage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "pedagogicalProgression": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "practiceAndRetrieval": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "activityQualityAndVariety": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "linguisticAccuracyAndNaturalness": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "sourceQualityAndCurrency": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "learnerSupportAndClarity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "qaIntegrity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                }
              }
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "strengths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "remainingWeaknesses": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "scopeExclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Explicit product-scope exclusions. These do not count as hidden gaps and must be justified."
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "unitRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "lessonRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "notes": {
      "type": "string"
    },
    "audioStatus": {
      "enum": [
        "not_required",
        "blocked_until_level_final",
        "pending",
        "ready",
        "stale",
        "failed"
      ],
      "default": "blocked_until_level_final"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "final"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "completionAssessment"
        ],
        "properties": {
          "completionAssessment": {
            "properties": {
              "cefrCoverageComplete": {
                "const": true
              },
              "progressionComplete": {
                "const": true
              },
              "practiceAndRetrievalComplete": {
                "type": "boolean"
              },
              "skillModeCoverageComplete": {
                "type": "boolean"
              },
              "requiredGaps": {
                "type": "array"
              }
            }
          }
        }
      }
    }
  ]
}
