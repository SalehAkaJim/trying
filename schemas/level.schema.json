{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "level.schema.json",
  "title": "CEFR Level Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "languageId", "level", "status", "coverage"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "id": {"type": "string", "minLength": 1},
    "languageId": {"type": "string", "minLength": 1},
    "level": {"enum": ["Pre-A1", "A1", "A2", "B1", "B2", "C1", "C2"]},
    "status": {"enum": ["unassessed", "planning", "building", "review", "final"]},
    "structureRationale": {
      "type": ["string", "null"],
      "description": "Explains the current curriculum structure. It must be coverage/pedagogy based and must not use numeric unit/lesson quotas as justification."
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["communicativeTargets", "linguisticTargets", "situations", "gaps"],
      "properties": {
        "communicativeTargets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "linguisticTargets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "situations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "gaps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "sourceRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "unitRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "lessonRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "notes": {"type": "string"}
  }
}
