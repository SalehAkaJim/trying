{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audio-voice-lock.schema.json",
  "title": "Audio Voice Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "language", "resolvedAt", "standalone", "characters"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "provider": {"const": "elevenlabs"},
    "language": {"type": "string", "minLength": 2},
    "resolvedAt": {"type": "string", "format": "date-time"},
    "standalone": {"$ref": "#/$defs/voice"},
    "characters": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/characterVoice"}
    }
  },
  "$defs": {
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voiceId", "voiceName", "strategy"],
      "properties": {
        "voiceId": {"type": "string", "minLength": 1},
        "voiceName": {"type": "string", "minLength": 1},
        "strategy": {"enum": ["preference_name", "profile_match", "standalone_inherited", "explicit"]},
        "matchScore": {"type": ["number", "null"]},
        "providerMetadata": {"type": ["object", "null"]}
      }
    },
    "characterVoice": {
      "allOf": [
        {"$ref": "#/$defs/voice"},
        {
          "type": "object",
          "properties": {
            "characterKey": {"type": "string", "minLength": 1}
          },
          "required": ["characterKey"]
        }
      ]
    }
  }
}
